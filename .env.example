# AIbeaty platform + Maya assistant — environment template.
# Copy to .env (gitignored) and fill in. NEVER commit real values.

# --- LLM provider (any OpenAI-compatible /chat/completions with function calling) ---
# Default base URL if unset: https://ollama.com/v1
LLM_BASE_URL=
# Either the raw key...
LLM_API_KEY=
# ...or a path to a file containing the key (preferred; default: ~/.ollama/api_key)
LLM_API_KEY_FILE=
# Default model if unset: deepseek-v4-pro:0813 (see docs/assistant.md for the tested matrix)
LLM_MODEL=
# Request timeout, ms (default 90000)
LLM_TIMEOUT_MS=

# --- Platform server ---
# HTTP port (default 4174). PLATFORM_PORT also works; PORT wins.
PORT=
# Bind host (default 127.0.0.1; set 0.0.0.0 inside Docker)
PLATFORM_HOST=
# SQLite file path (default apps/platform/data/platform.db).
# Set a unique path per instance to run parallel instances without collisions.
PLATFORM_DB_PATH=

# --- Owner login (docs/auth.md) ---
# Signing key for session cookies. Leave empty and the server generates one on first
# start and keeps it next to the database (mode 600) so restarts don't sign owners out.
# Setting it explicitly is what lets you move the DB between boxes without a mass logout.
SESSION_SECRET=
# Where that generated key lives (default: <dir of PLATFORM_DB_PATH>/session-secret)
SESSION_SECRET_FILE=
# Force the Secure flag on the session cookie. Normally auto-detected from
# X-Forwarded-Proto; set to 1 if you terminate TLS somewhere that doesn't send it.
SESSION_COOKIE_SECURE=
# Slug of the salon this instance serves (default: the slug in data/demo-platform.json).
# An owner account is bound to a slug and can never read another one.
SALON_SLUG=

# --- Spend guard (docs/assistant.md) ---
# Hard cap on LLM turns per salon-timezone day (default 400). At 80% the owner
# gets one email; at 100% Maya switches to a polite stop until local midnight.
ASSISTANT_DAILY_TURNS_CAP=

# --- Escalation alert emails (docs/assistant.md) ---
# Inbox for "нужен человек" alerts via formsubmit.co. Unset = alerts off.
ALERT_EMAIL=
# Origin used in the alert's inbox deep link (default https://aibeaty.remolda.com)
ALERT_LINK_BASE=
# Origin/Referer sent with the formsubmit.co POST — must be a formsubmit-activated
# site or the relay refuses silently (default https://aibeaty.pages.dev)
ALERT_ORIGIN=

# --- Telegram bridge (npm run assistant:telegram) ---
# Bot token from @BotFather. Required for the bridge; never commit or print it.
TELEGRAM_BOT_TOKEN=
# Where the platform/assistant server lives (default http://127.0.0.1:4174)
ASSISTANT_BASE_URL=
# Long-poll hold, seconds (default 50). Tests override TELEGRAM_API_BASE to a stub.
TELEGRAM_POLL_TIMEOUT_SEC=
