# AIbeaty platform + Maya assistant — environment template.
# Copy to .env (gitignored) and fill in. NEVER commit real values.

# --- LLM provider (any OpenAI-compatible /chat/completions with function calling) ---
# Default base URL if unset: https://ollama.com/v1
LLM_BASE_URL=
# Either the raw key...
LLM_API_KEY=
# ...or a path to a file containing the key (preferred; default: ~/.ollama/api_key)
LLM_API_KEY_FILE=
# Default model if unset: deepseek-v4-pro:0813 (see docs/assistant.md for the tested matrix)
LLM_MODEL=
# Request timeout, ms (default 90000)
LLM_TIMEOUT_MS=

# --- Platform server ---
# HTTP port (default 4174). PLATFORM_PORT also works; PORT wins.
PORT=
# Bind host (default 127.0.0.1; set 0.0.0.0 inside Docker)
PLATFORM_HOST=
# SQLite file path (default apps/platform/data/platform.db).
# Set a unique path per instance to run parallel instances without collisions.
PLATFORM_DB_PATH=

# --- Telegram bridge (npm run assistant:telegram) ---
# Bot token from @BotFather. Required for the bridge; never commit or print it.
TELEGRAM_BOT_TOKEN=
# Where the platform/assistant server lives (default http://127.0.0.1:4174)
ASSISTANT_BASE_URL=
# Long-poll hold, seconds (default 50). Tests override TELEGRAM_API_BASE to a stub.
TELEGRAM_POLL_TIMEOUT_SEC=
